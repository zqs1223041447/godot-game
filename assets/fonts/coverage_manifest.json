      "strings": [
        {
          "line": 61,
          "text": "回收"
        },
        {
          "line": 63,
          "text": "校准"
        },
        {
          "line": 85,
          "text": "校准碎片 %d"
        },
        {
          "line": 86,
          "text": "校准碎片：%d 枚\n回收会消耗所选装备；校准只消耗碎片。"
        },
        {
          "line": 92,
          "text": "回收此装备，获得校准碎片 %d 枚。\n回收会消耗所选装备。"
        },
        {
          "line": 94,
          "text": "消耗校准碎片 %d 枚，重掷现有词缀的数值。\n词缀种类与阶级保持不变，数值可能不变或降低。"
        },
        {
          "line": 101,
          "text": "请先选择可制作的装备。"
        },
        {
          "line": 106,
          "text": "暂无可用的制作报价。"
        },
        {
          "line": 109,
          "text": "制作报价缺少有效的校准碎片数量。"
        },
        {
          "line": 111,
          "text": "校准碎片不足：需要 %d 枚，现有 %d 枚。"
        }
      ]
    },
    {
      "commit": "c2e711bdcccaefbbfdcc7bb9e8dd41db5010287f",
      "path": "scripts/items/crafting_rules.gd",
      "blob_sha256": "d7ec2362d0f1696a5118b147674cad257a8355a7a62dc2d5b7f63c068abf479f",
      "strings": [
        {
          "line": 25,
          "text": "回收与数值校准"
        },
        {
          "line": 32,
          "text": "校准碎片"
        },
        {
          "line": 32,
          "text": "枚"
        },
        {
          "line": 35,
          "text": "回收"
        },
        {
          "line": 37,
          "text": "数值校准"
        },
        {
          "line": 65,
          "text": "校准种子必须为整数类型。"
        },
        {
          "line": 73,
          "text": "校准结果未通过装备目录验证。"
        },
        {
          "line": 78,
          "text": "校准结果无法派生装备属性。"
        },
        {
          "line": 90,
          "text": "装备实例未通过当前目录验证。"
        },
        {
          "line": 92,
          "text": "普通无词缀装备不支持回收或数值校准。"
        },
        {
          "line": 94,
          "text": "此稀有度尚未定义工艺成本。"
        },
        {
          "line": 100,
          "text": "底材或词缀资格无效。"
        },
        {
          "line": 107,
          "text": "词缀阶级不存在。"
        }
      ]
    },
    {
      "commit": "5d5bba0baeb680cf56e0244e7c0b53490e290757",
      "path": "scripts/items/crafting_transaction_planner.gd",
      "blob_sha256": "ae84240c46c3981ca44783129717bc49b84b54769088f7b47fbbb194d34792b7",
      "usage": "quote/plan failures expose these strings in the reason field; callers may display them",
      "strings": [
        {
          "line": 20,
          "text": "工艺操作必须为 salvage 或 recalibrate。"
        },
        {
          "line": 22,
          "text": "物品标识必须为非空字符串。"
        },
        {
          "line": 27,
          "text": "当前存档受写保护，不能进行工艺事务。"
        },
        {
          "line": 29,
          "text": "当前库存未持有此物品。"
        },
        {
          "line": 31,
          "text": "固定示例或机制物品不支持工艺事务。"
        },
        {
          "line": 33,
          "text": "请先卸下物品，再进行回收或数值校准。"
        },
        {
          "line": 35,
          "text": "修订号已达上限，不能产生下一次事务。"
        },
        {
          "line": 44,
          "text": "工艺规则返回了无效材料数量。"
        },
        {
          "line": 58,
          "text": "报价结构无效，请重新获取报价。"
        },
        {
          "line": 62,
          "text": "报价标识或类型无效，请重新获取报价。"
        },
        {
          "line": 68,
          "text": "物品、修订号或工艺规则已变化，请重新获取报价。"
        },
        {
          "line": 70,
          "text": "报价与权威规则不一致，请重新获取报价。"
        },
        {
          "line": 72,
          "text": "事务种子必须为整数类型。"
        },
        {
          "line": 84,
          "text": "工艺规则的计划与报价不一致。"
        },
        {
          "line": 104,
          "text": "工艺上下文必须恰好包含约定的七个字段。"
        },
        {
          "line": 106,
          "text": "修订号必须为非负整数类型。"
        },
        {
          "line": 110,
          "text": "材料仅允许非负整数类型的 calibration_shard 余额。"
        },
        {
          "line": 114,
          "text": "库存、实例、穿戴、位置或存档权限类型无效。"
        },
        {
          "line": 118,
          "text": "库存包含重复、无效或缺少实例的物品标识。"
        },
        {
          "line": 124,
          "text": "装备实例与目录、表键或所有权不一致。"
        },
        {
          "line": 128,
          "text": "穿戴槽或物品所有权无效。"
        },
        {
          "line": 132,
          "text": "物品与穿戴槽不匹配。"
        },
        {
          "line": 136,
          "text": "背包位置键或坐标类型无效。"
        },
        {
          "line": 139,
          "text": "背包物品位置与所有权或穿戴状态不一致。"
        },
        {
          "line": 141,
          "text": "未知背包位置键。"
        },
        {
          "line": 144,
          "text": "未穿戴物品缺少背包位置。"
        },
        {
          "line": 176,
          "text": "校准碎片余额不足。"
        },
        {
          "line": 180,
          "text": "回收收益会使材料余额溢出。"
        }
      ]
    }
