[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 40

[node name="Center" type="CenterContainer" parent="Margin"]
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Margin/Center"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Margin/Center/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 42
text = "godot游戏仓"
horizontal_alignment = 1

[node name="Goal" type="Label" parent="Margin/Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.83, 0.92, 1)
theme_override_font_sizes/font_size = 22
text = "以构筑和技能效果组合为核心\n刷怪和制作都是手段"
horizontal_alignment = 1

[node name="Status" type="Label" parent="Margin/Center/Content"]
layout_mode = 2
text = "Godot 4.6.3 · Windows x86_64\n工程已初始化，玩法待开发"
horizontal_alignment = 1

[node name="QuitButton" type="Button" parent="Margin/Center/Content"]
custom_minimum_size = Vector2(220, 48)
layout_mode = 2
size_flags_horizontal = 4
text = "退出 / Esc"

[connection signal="pressed" from="Margin/Center/Content/QuitButton" to="." method="_on_quit_pressed"]
